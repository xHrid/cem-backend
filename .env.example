# Copy to .env and edit. docker-compose reads this automatically.
# Applies to API, pipeline, and frontend. Recreate with compose up -d after changing.
DEBUG=false
MAX_UPLOAD_MB=2048
# CORS: which web origins may call this API from a browser. "*" = any.
# Set to your static-site URL in production, e.g. https://cem-toolkit.onrender.com
ALLOWED_ORIGINS=*

# ---- Airflow dispatch (optional) ----
# Blank = /analyze runs the pipeline locally (blocking, no polling needed).
# Set AIRFLOW_BASE_URL to enable: /analyze triggers the DAG and returns a
# job_id the client polls via GET /api/v1/jobs/<job_id>. Use the internal docker
# hostname (same network), e.g. http://corestac-stacd-airflow:8080
AIRFLOW_BASE_URL=
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=cem_pipeline
AIRFLOW_TIMEOUT=10
# BirdNET parallel workers. Each loads its own TensorFlow model (~hundreds of
# MB). If BirdNET crashes with "BrokenProcessPool", lower to 1 and/or raise
# Docker Desktop's memory limit. Default 2.
BIRDNET_MAX_WORKERS=2
# Acoustic indices parallel workers. Same BrokenProcessPool failure mode as
# BirdNET above, just with a lighter per-worker footprint; the auto-detected
# default (RAM/0.5GB, capped at 8) can still be too aggressive on machines
# with a few GB of RAM. Blank = auto-detect. Set to 2 if indices jobs crash.
INDICES_MAX_WORKERS=

# ---- Storage root ----------------------------------------------------------
# Shared DATA_DIR. Server uploads/jobs/results are private by default inside
# project.json. Make Public marks the whole project public only after server
# compute has succeeded; the master indexer reads public projects from here.
CEM_DATA_DIR_HOST=./data
# Backward-compatible fallback used only if CEM_DATA_DIR_HOST is unset.
HOST_DATA_DIR=./data

# Host port for the compute backend. Defaults to 8002 so the CEM Master
# frontend can keep 8000 and the master backend can keep 8001.
COMPUTE_BACKEND_PORT=8002

# ---- Frontend (started by THIS compose file) ----
# The compute page lives in ../cem-frontend but is started from here, so one
# `docker compose up -d` brings up the whole compute stack. Override the context
# if the two repos are not siblings.
COMPUTE_FRONTEND_CONTEXT=../cem-frontend
COMPUTE_FRONTEND_PORT=8080

# Written into js/core/Config.js when the frontend container starts. This is the
# API address the BROWSER uses, so localhost + the published port -- not the
# compose service name, which means nothing outside the Docker network.
SERVER_BASE_URL=http://localhost:8002

# Optional. Blank disables Google Drive features only; the page still loads and
# server-compute mode (upload -> analyse -> publish) is unaffected.
GOOGLE_CLIENT_ID=
PICKER_API_KEY=

# ---- FileBrowser share links (optional) ----
# Blank = disabled; the backend skips share creation everywhere and job outputs
# on the master page are named but not linked.
#
# ⚠️ FILEBROWSER_PASSWORD is NOT admin on recent images -- they generate a random
# one on first start. Find it with:
#     docker compose logs filebrowser | grep -i password
# or set a known one:
#     docker compose exec filebrowser filebrowser users update admin --password X
FILEBROWSER_BASE_URL=
FILEBROWSER_USERNAME=admin
FILEBROWSER_PASSWORD=

# ---- Publish to CEM Master ----
# Make Public no longer calls the master backend directly. Run the master
# indexer with --watch so it polls DATA_DIR and indexes public projects.

# ---- Versioning (item 12) ----
# Compute API version stamped into outputs + STAC items. Bump on API changes.
API_VERSION=1.1.0

# ---- STAC provenance (item 9) ----
# A STAC 1.0 Item sidecar (<file>.stac.json) is written next to every output.
STAC_ENABLED=true
STAC_COLLECTION=cem-bioacoustics
# Optional: if set, STAC asset hrefs become absolute under this base URL
# (e.g. the file-browser/raw-data origin). Blank = relative hrefs.
STAC_ASSET_BASE_URL=

# ---- Output retention (item 15) ----
# The cluster is compute, not long-term storage. Job dirs older than
# RETENTION_HOURS are swept every RETENTION_SWEEP_MINUTES. 0 disables.
RETENTION_HOURS=168
RETENTION_SWEEP_MINUTES=60
