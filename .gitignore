# ---- Secrets: NEVER commit ----
.env
*.env
.env.*
!.env.example

# ---- Runtime job data (uploads + results, ~GBs) ----
# Ignore the CONTENTS, not the dir itself, so .gitkeep can be re-included
# (git won't look inside a fully-ignored directory).
data/*
!data/.gitkeep

# ---- Logs ----
logs/
*.log

# ---- Tests ----
tests/
!server/tests/
server/tests/*
!server/tests/test_debug.py
!pipeline/tests/
pipeline/tests/*
!pipeline/tests/test_snippets.py

# ---- Docs ----
*.md
!README.md
!DEBUGGING.md

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
server/.venv/

# ---- Caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Build / packaging ----
*.zip
build/
dist/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
